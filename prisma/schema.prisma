generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ORGANIZER
  ADMIN
}

enum EventType {
  INTERNAL
  EXTERNAL
  MIXED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum EventOrganizerRole {
  FULL
  CHECKIN_ONLY
}

enum RegistrantStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
  CANCELLED
}

enum WaitlistPromotion {
  MANUAL
  AUTO
}

enum NotificationChannel {
  EMAIL
  LINE
  BOTH
}

model User {
  id                  String           @id @default(cuid())
  name                String
  email               String           @unique
  passwordHash        String?
  /// Active Directory objectGUID, set on the first LDAP sign-in. Stable across renames and email changes.
  ldapId              String?          @unique
  role                UserRole         @default(ORGANIZER)
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  ownedEvents         Event[]          @relation("EventOwner")
  organizerOf         EventOrganizer[]
  approvedRegistrants Registrant[]     @relation("RegistrantApprover")
  performedCheckIns   CheckIn[]        @relation("CheckInOperator")
  voidedCheckIns      CheckIn[]        @relation("CheckInVoider")
  auditLogs           AuditLog[]       @relation("AuditActor")
  accountTokens       UserToken[]      @relation("TokenOwner")
  issuedTokens        UserToken[]      @relation("TokenIssuer")
  updatedSettings     SystemSetting[]  @relation("SettingUpdater")
  resolvedDataRequests DataRequest[]   @relation("DataRequestResolver")
  announcements        Announcement[]  @relation("AnnouncementAuthor")
}

enum UserTokenKind {
  INVITE
  RESET
}

model UserToken {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("TokenOwner", fields: [userId], references: [id], onDelete: Cascade)
  kind        UserTokenKind
  tokenHash   String        @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdBy   User?         @relation("TokenIssuer", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([userId, kind])
  @@index([createdById])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  keyHash   String
  createdAt DateTime @default(now())

  @@index([keyHash, createdAt])
}

model Event {
  id                   String           @id @default(cuid())
  slug                 String           @unique
  title                String
  description          String?          @db.Text
  location             String?
  eventType            EventType        @default(INTERNAL)
  status               EventStatus      @default(DRAFT)
  coverImageUrl        String?
  coverImageKey        String?
  fields               Json
  fieldsVersion        Int              @default(1)
  registrationDeadline DateTime?
  autoApprove          Boolean          @default(false)
  /// Off: a full day/course refuses new registrations instead of queueing them. People already queued stay queued.
  waitlistEnabled      Boolean          @default(false)
  seatMode             String           @default("per_day")
  maxSeats             Int?
  attendanceThreshold  Int?
  pendingHoldHours     Int?
  waitlistPromotion    WaitlistPromotion @default(MANUAL)
  retentionDays        Int              @default(365)
  anonymizedAt         DateTime?
  deletedAt            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  clonedFromId         String?
  clonedFrom           Event?           @relation("EventClones", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones               Event[]          @relation("EventClones")
  ownerId              String
  owner                User             @relation("EventOwner", fields: [ownerId], references: [id])
  organizers           EventOrganizer[]
  days                 EventDay[]
  sessions             Session[]
  registrants          Registrant[]
  auditLogs            AuditLog[]
  dataRequests         DataRequest[]
  notifications        NotificationLog[]
  announcements        Announcement[]

  @@index([ownerId])
  @@index([status, registrationDeadline])
  @@index([deletedAt])
  @@index([clonedFromId])
}

model EventDay {
  id             String               @id @default(cuid())
  eventId        String
  event          Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  date           DateTime             @db.Date
  maxSeats       Int?
  isClosed       Boolean              @default(false)
  registrantDays RegistrantEventDay[]
  sessions       Session[]

  @@unique([eventId, date])
  @@index([date])
}

model EventOrganizer {
  id      String             @id @default(cuid())
  eventId String
  event   Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    EventOrganizerRole @default(FULL)
  addedAt DateTime           @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

model Session {
  id         String    @id @default(cuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventDayId String?
  eventDay   EventDay? @relation(fields: [eventDayId], references: [id], onDelete: Cascade)
  label      String
  startTime  DateTime?
  endTime    DateTime?
  sortOrder  Int       @default(0)
  checkIns   CheckIn[]

  @@index([eventId])
  @@index([eventDayId])
}

model Registrant {
  id              String              @id @default(cuid())
  eventId         String
  event           Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers         Json
  /// Denormalized from answers for name search/ordering; see src/features/registrations/display-name.ts.
  displayName     String?             @db.VarChar(191)
  fieldsVersion   Int                 @default(1)
  registeredAt    DateTime            @default(now())
  consentedAt     DateTime?
  consentVersion  String?
  consentIp       String?             @db.VarChar(64)
  updatedAt       DateTime            @updatedAt
  email           String?
  dedupeKey       String?
  lineUserId      String?
  /// Day statuses last told to the registrant over LINE ({eventDayId: status}); new messages carry only what changed.
  lineNotifiedDays Json?
  emailNotifiedHash String? @db.Char(64)
  notifyVia       NotificationChannel @default(EMAIL)
  autoApproveAtRegistration Boolean    @default(false)
  status          RegistrantStatus    @default(PENDING)
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?               @relation("RegistrantApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  cancelledAt     DateTime?
  rejectReason    String?             @db.Text
  anonymizedAt    DateTime?
  qrCode          String?             @unique
  statusTokenHash String               @unique
  checkIns        CheckIn[]
  days            RegistrantEventDay[]
  dataRequests    DataRequest[]
  notifications   NotificationLog[]

  @@unique([eventId, dedupeKey])
  @@index([eventId, email])
  @@index([eventId, status, registeredAt])
  @@index([eventId, displayName])
  @@index([approvedById])
}

model RegistrantEventDay {
  id           String           @id @default(cuid())
  registrantId String
  registrant   Registrant       @relation(fields: [registrantId], references: [id], onDelete: Cascade)
  eventDayId   String
  eventDay     EventDay         @relation(fields: [eventDayId], references: [id], onDelete: Cascade)
  status       RegistrantStatus @default(PENDING)
  waitlistedAt DateTime?
  pendingSince DateTime?

  @@unique([registrantId, eventDayId])
  @@index([eventDayId, status, waitlistedAt])
  @@index([status, pendingSince])
}

model CheckIn {
  id            String     @id @default(cuid())
  registrantId  String
  registrant    Registrant @relation(fields: [registrantId], references: [id], onDelete: Cascade)
  sessionId     String
  session       Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  checkedInAt   DateTime   @default(now())
  checkedInById String?
  checkedInBy   User?      @relation("CheckInOperator", fields: [checkedInById], references: [id], onDelete: SetNull)
  voidedAt      DateTime?
  voidedById    String?
  voidedBy      User?      @relation("CheckInVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  activeKey     String?    @unique
  clientEventId String?    @unique
  method        String?    @db.VarChar(16)
  /// Check-in station name set on the device (e.g. "จุดที่ 2 · โต๊ะหน้าห้อง"); null when the device has none.
  station       String?    @db.VarChar(64)
  syncedAt      DateTime   @default(now())
  isOverride    Boolean    @default(false)
  overrideNote  String?    @db.VarChar(500)

  @@index([sessionId, checkedInAt])
  @@index([registrantId])
  @@index([checkedInById])
  @@index([sessionId, voidedAt, checkedInAt])
  @@index([sessionId, syncedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([actorId, createdAt])
}

model RegistrationAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

// System-wide feature switches that admins turn on/off from /admin?view=settings. A missing row means the
// feature's default from src/features/settings/features.ts.
model SystemSetting {
  key         String   @id @db.VarChar(64)
  enabled     Boolean
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("SettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

enum DataRequestStatus {
  OPEN
  COMPLETED
  REJECTED
}

// PDPA data-subject request sent from the registrant's status page (spec: สิทธิ์เจ้าของข้อมูล). Only "DELETE" exists
// for now; access/correction already happen on the status page itself. Kept after completion as evidence.
model DataRequest {
  id             String            @id @default(cuid())
  eventId        String
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrantId   String
  registrant     Registrant        @relation(fields: [registrantId], references: [id], onDelete: Cascade)
  kind           String            @default("DELETE") @db.VarChar(32)
  status         DataRequestStatus @default(OPEN)
  /// The registrant's own words; cleared when the request is completed.
  reason         String?           @db.Text
  requestedAt    DateTime          @default(now())
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?             @relation("DataRequestResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?           @db.Text

  @@index([eventId, status, requestedAt])
  @@index([registrantId, status])
  @@index([resolvedById])
}

enum NotificationStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  SKIPPED
}

// Outbox for registrant notifications (spec: NotificationLog, sent from a background queue). A row is queued in the
// same transaction as the status change and delivered after the response; retries back off via nextAttemptAt.
// No recipient address or message text is stored: contact details live on Registrant and are cleared by retention.
model NotificationLog {
  id            String              @id @default(cuid())
  eventId       String
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrantId  String
  registrant    Registrant          @relation(fields: [registrantId], references: [id], onDelete: Cascade)
  channel       NotificationChannel
  /// linked | status | resend | fallback | announcement
  kind          String              @db.VarChar(32)
  /// Set for kind "announcement": the organizer's message this row delivers.
  announcementId String?
  announcement  Announcement?       @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  status        NotificationStatus  @default(QUEUED)
  attempts      Int                 @default(0)
  /// LINE X-Line-Retry-Key: the same UUID on every retry so LINE never delivers one message twice.
  retryKey      String              @db.Char(36)
  /// Short technical reason (HTTP status / LINE error code), never personal data.
  error         String?             @db.VarChar(255)
  nextAttemptAt DateTime            @default(now())
  sentAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, nextAttemptAt])
  @@index([registrantId, createdAt])
  @@index([eventId, status])
  @@index([announcementId, status])
}

/// An organizer's message to the people registered for an event (spec: broadcast). Each recipient gets one
/// NotificationLog row (kind "announcement") on their chosen channel; this row keeps what was said and by whom.
model Announcement {
  id            String            @id @default(cuid())
  eventId       String
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorId      String?
  author        User?             @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  subject       String            @db.VarChar(120)
  body          String            @db.Text
  /// Registrant statuses it went to, e.g. ["APPROVED","PENDING"].
  audience      Json
  /// People with no way to reach them (no email and LINE not connected) when it was sent.
  unreachable   Int               @default(0)
  createdAt     DateTime          @default(now())
  notifications NotificationLog[]

  @@index([eventId, createdAt])
}
