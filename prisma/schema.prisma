generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ORGANIZER
  STAFF
  ADMIN
}

enum EventType {
  INTERNAL
  EXTERNAL
  MIXED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum EventOrganizerRole {
  FULL
  CHECKIN_ONLY
}

enum RegistrantStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
  CANCELLED
}

enum WaitlistPromotion {
  MANUAL
  AUTO
}

enum NotificationChannel {
  EMAIL
  LINE
  BOTH
}

model User {
  id                  String           @id @default(cuid())
  name                String
  email               String           @unique
  passwordHash        String?
  role                UserRole         @default(ORGANIZER)
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  ownedEvents         Event[]          @relation("EventOwner")
  organizerOf         EventOrganizer[]
  approvedRegistrants Registrant[]     @relation("RegistrantApprover")
  performedCheckIns   CheckIn[]        @relation("CheckInOperator")
  voidedCheckIns      CheckIn[]        @relation("CheckInVoider")
  auditLogs           AuditLog[]       @relation("AuditActor")
  accountTokens       UserToken[]      @relation("TokenOwner")
  issuedTokens        UserToken[]      @relation("TokenIssuer")
}

enum UserTokenKind {
  INVITE
  RESET
}

model UserToken {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("TokenOwner", fields: [userId], references: [id], onDelete: Cascade)
  kind        UserTokenKind
  tokenHash   String        @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdBy   User?         @relation("TokenIssuer", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([userId, kind])
  @@index([createdById])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  keyHash   String
  createdAt DateTime @default(now())

  @@index([keyHash, createdAt])
}

model Event {
  id                   String           @id @default(cuid())
  slug                 String           @unique
  title                String
  description          String?          @db.Text
  location             String?
  eventType            EventType        @default(INTERNAL)
  status               EventStatus      @default(DRAFT)
  coverImageUrl        String?
  coverImageKey        String?
  fields               Json
  fieldsVersion        Int              @default(1)
  registrationDeadline DateTime?
  autoApprove          Boolean          @default(false)
  seatMode             String           @default("per_day")
  maxSeats             Int?
  attendanceThreshold  Int?
  pendingHoldHours     Int?
  waitlistPromotion    WaitlistPromotion @default(MANUAL)
  retentionDays        Int              @default(365)
  anonymizedAt         DateTime?
  deletedAt            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  ownerId              String
  owner                User             @relation("EventOwner", fields: [ownerId], references: [id])
  organizers           EventOrganizer[]
  days                 EventDay[]
  sessions             Session[]
  registrants          Registrant[]
  auditLogs            AuditLog[]

  @@index([ownerId])
  @@index([status, registrationDeadline])
  @@index([deletedAt])
}

model EventDay {
  id             String               @id @default(cuid())
  eventId        String
  event          Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  date           DateTime             @db.Date
  maxSeats       Int?
  isClosed       Boolean              @default(false)
  registrantDays RegistrantEventDay[]
  sessions       Session[]

  @@unique([eventId, date])
  @@index([date])
}

model EventOrganizer {
  id      String             @id @default(cuid())
  eventId String
  event   Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    EventOrganizerRole @default(FULL)
  addedAt DateTime           @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

model Session {
  id         String    @id @default(cuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventDayId String?
  eventDay   EventDay? @relation(fields: [eventDayId], references: [id], onDelete: Cascade)
  label      String
  startTime  DateTime?
  endTime    DateTime?
  sortOrder  Int       @default(0)
  checkIns   CheckIn[]

  @@index([eventId])
  @@index([eventDayId])
}

model Registrant {
  id              String              @id @default(cuid())
  eventId         String
  event           Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers         Json
  fieldsVersion   Int                 @default(1)
  registeredAt    DateTime            @default(now())
  consentedAt     DateTime?
  consentVersion  String?
  consentIp       String?             @db.VarChar(64)
  updatedAt       DateTime            @updatedAt
  email           String?
  dedupeKey       String?
  lineUserId      String?
  notifyVia       NotificationChannel @default(EMAIL)
  autoApproveAtRegistration Boolean    @default(false)
  status          RegistrantStatus    @default(PENDING)
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?               @relation("RegistrantApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  cancelledAt     DateTime?
  rejectReason    String?             @db.Text
  anonymizedAt    DateTime?
  qrCode          String?             @unique
  statusTokenHash String               @unique
  checkIns        CheckIn[]
  days            RegistrantEventDay[]

  @@unique([eventId, dedupeKey])
  @@index([eventId, email])
  @@index([eventId, status, registeredAt])
  @@index([approvedById])
}

model RegistrantEventDay {
  id           String           @id @default(cuid())
  registrantId String
  registrant   Registrant       @relation(fields: [registrantId], references: [id], onDelete: Cascade)
  eventDayId   String
  eventDay     EventDay         @relation(fields: [eventDayId], references: [id], onDelete: Cascade)
  status       RegistrantStatus @default(PENDING)
  waitlistedAt DateTime?
  pendingSince DateTime?

  @@unique([registrantId, eventDayId])
  @@index([eventDayId, status, waitlistedAt])
  @@index([status, pendingSince])
}

model CheckIn {
  id            String     @id @default(cuid())
  registrantId  String
  registrant    Registrant @relation(fields: [registrantId], references: [id], onDelete: Cascade)
  sessionId     String
  session       Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  checkedInAt   DateTime   @default(now())
  checkedInById String?
  checkedInBy   User?      @relation("CheckInOperator", fields: [checkedInById], references: [id], onDelete: SetNull)
  voidedAt      DateTime?
  voidedById    String?
  voidedBy      User?      @relation("CheckInVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  activeKey     String?    @unique
  clientEventId String?    @unique
  method        String?    @db.VarChar(16)
  syncedAt      DateTime   @default(now())
  isOverride    Boolean    @default(false)
  overrideNote  String?    @db.VarChar(500)

  @@index([sessionId, checkedInAt])
  @@index([registrantId])
  @@index([checkedInById])
  @@index([sessionId, voidedAt, checkedInAt])
  @@index([sessionId, syncedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([actorId, createdAt])
}

model RegistrationAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}
