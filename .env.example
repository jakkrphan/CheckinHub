# Database
DATABASE_URL="mysql://checkinhub:local_password@localhost:3307/checkinhub"

# Organizer authentication
AUTH_SECRET="replace-with-at-least-32-random-bytes"
AUTH_TRUST_HOST="true"

# Public registration bot protection (Cloudflare Turnstile)
# Local development: use Cloudflare's always-pass TEST keys so the integration tests (which send the dummy token
# XXXX.DUMMY.TOKEN.XXXX) work: site "1x00000000000000000000AA", secret "1x0000000000000000000000000000000AA".
# Production: the real keys, with the production domain added to the widget in Cloudflare. Never put real keys here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Email notifications (Resend) — EMAIL_FROM must use a domain verified in Resend; until then Resend only sends
# from onboarding@resend.dev to the Resend account owner's address.
RESEND_API_KEY=""
EMAIL_FROM="CheckInHub <noreply@example.com>"

# LINE Login and Messaging API
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
LINE_MESSAGING_ACCESS_TOKEN=""

# S3-compatible object storage
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""

# Feature switches (off unless "true")
# Self check-in kiosk with staff PIN — default only; admins switch it in /admin?view=settings
FEATURE_KIOSK="false"

# Authenticated scheduled maintenance (pending-seat expiry)
CRON_SECRET=""
