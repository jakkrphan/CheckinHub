[Unit]
Description=CheckInHub Next.js application
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=checkinhub
Group=checkinhub
WorkingDirectory=/srv/checkinhub
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /srv/checkinhub/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3100
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
