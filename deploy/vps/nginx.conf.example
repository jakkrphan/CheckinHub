# Install as /etc/nginx/sites-available/checkinhub after the apex A record and www CNAME point to this VPS.
# Obtain the TLS certificate with Certbot before accepting real registrations.
server {
    listen 80;
    listen [::]:80;
    server_name checkinhub.tech www.checkinhub.tech;

    client_max_body_size 8m;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The app's login and registration rate limits use the first forwarded IP.
        # Replace client-supplied X-Forwarded-For instead of appending to it.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}
