{
  "name": "check-in-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test src/server/authorization/*.test.mjs",
    "test:integration:schedule": "node scripts/smoke-schedule.mjs",
    "test:integration:admin": "node scripts/smoke-admin.mjs",
    "test:integration:registration": "node scripts/smoke-registration.mjs",
    "test:integration:concurrency": "node scripts/smoke-concurrency.mjs",
    "test:integration:cancellation": "node scripts/smoke-cancellation-concurrency.mjs",
    "test:integration:pending-holds": "node scripts/smoke-pending-holds.mjs",
    "test:integration:whole-course": "node scripts/smoke-whole-course.mjs",
    "test:integration:rules": "node scripts/smoke-rules.mjs",
    "maintenance:pending-holds": "node scripts/run-pending-holds.mjs",
    "db:up": "docker compose up -d --wait mysql",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mysql",
    "db:setup": "docker compose up -d --wait mysql && prisma migrate deploy && prisma generate && prisma db seed",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "admin:create": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@zxing/browser": "^0.2.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
